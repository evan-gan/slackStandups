# Slack bot token (xoxb-...) — needs chat:write scope
SLACK_BOT_TOKEN=xoxb-your-token-here

# Channel ID to post standups in (e.g. C01ABCDEF)
SLACK_CHANNEL_ID=C01ABCDEF

# Standup message (Slack mrkdwn format). Use {date} for today's date.
# In Fizzy mode this renders as the greeting section above the overview.
STANDUP_MESSAGE=:sunrise: *Standup for {date}*\nDrop your update in the thread!

# Standup prompt. In plain mode it's posted as a thread reply.
# In Fizzy mode it renders as a markdown block at the bottom of the parent
# message (no separate thread reply is sent).
THREAD_MESSAGE=:thread: Reply here with your standup update!

# Cron schedule for standup message (default: 9:00 AM Mon-Fri)
STANDUP_CRON=0 9 * * 1-5

# Timezone for the cron schedule (default: America/New_York)
TZ=America/New_York

# --- Fizzy board overview (optional) ---
# When all FIZZY_* vars below are set, the standup post becomes a Block Kit
# overview of the configured Fizzy board. Otherwise the plain STANDUP_MESSAGE
# is used.

# Fizzy bearer access token. Create one at:
#   {FIZZY_BASE_URL}/{FIZZY_ACCOUNT_ID}/my/access_tokens
FIZZY_ACCESS_TOKEN=your_token_here

# Account ID — the number that appears in your Fizzy URLs, e.g. the "0000003"
# in https://fizzy.hackclub.com/0000003/my/access_tokens
FIZZY_ACCOUNT_ID=0000003

# ID of the board to summarize
FIZZY_BOARD_ID=board_xxx

# Optional host override for self-hosted Fizzy instances (defaults to https://fizzy.do)
# FIZZY_BASE_URL=https://fizzy.hackclub.com
