# Slack bot token (xoxb-...) — needs chat:write scope
SLACK_BOT_TOKEN=xoxb-your-token-here

# Channel ID to post standups in (e.g. C01ABCDEF)
SLACK_CHANNEL_ID=C01ABCDEF

# Standup message (Slack mrkdwn format). Use {date} for today's date.
STANDUP_MESSAGE=:sunrise: *Standup for {date}*\nDrop your update in the thread!

# Thread reply message (Slack mrkdwn format)
THREAD_MESSAGE=:thread: Reply here with your standup update!

# Cron schedule for standup message (default: 9:00 AM Mon-Fri)
STANDUP_CRON=0 9 * * 1-5

# Timezone for the cron schedule (default: America/New_York)
TZ=America/New_York
