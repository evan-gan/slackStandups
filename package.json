{
  "name": "standups-bot",
  "version": "1.0.0",
  "description": "Slack bot that posts daily standup messages on a cron schedule",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "post-now": "node src/index.js --once",
    "probe-fizzy": "node scripts/probe_fizzy.js",
    "dump-cards": "node scripts/dump_cards.js",
    "test": "node tests/run_all.js"
  },
  "dependencies": {
    "@37signals/fizzy": "^0.2.1",
    "@slack/web-api": "^7.9.1",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.7"
  }
}
